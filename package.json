{
  "name": "degreepath",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:local": "tsx scripts/local-db.ts",
    "data:import:uw": "tsx scripts/import-uw.ts",
    "data:seed": "tsx scripts/seed.ts",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"scripts/*.{ts,mjs}\" \"tests/**/*.{ts,tsx}\" \"*.{ts,mjs,json,md}\"",
    "postinstall": "prisma generate",
    "data:status": "tsx scripts/status.ts",
    "data:capture:uw": "tsx scripts/capture-fixtures.ts",
    "data:normalize": "tsx scripts/normalize-fixtures.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "cheerio": "^1.1.2",
    "lucide-react": "^0.468.0",
    "next": "^16.3.5",
    "next-auth": "^5.0.0-beta.32",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "robots-parser": "^3.0.1",
    "zod": "^3.25.0",
    "dotenv": "^17.2.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.0",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.3.5",
    "prisma": "^6.19.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.11",
    "prettier": "^3.6.0"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0"
  }
}
